{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hile",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "指南",
        "groups": [
          {
            "group": "概述",
            "pages": ["introduction", "architecture"]
          },
          {
            "group": "快速开始",
            "pages": ["quickstart"]
          },
          {
            "group": "核心概念",
            "pages": [
              "fundamentals/container",
              "fundamentals/lifecycle-and-events"
            ]
          },
          {
            "group": "HTTP 开发",
            "pages": [
              "fundamentals/http-pipeline",
              "fundamentals/http-next-pipeline"
            ]
          },
          {
            "group": "实用技巧",
            "pages": [
              "techniques/configuration",
              "techniques/database",
              "techniques/caching",
              "techniques/idempotency",
              "techniques/messaging"
            ]
          },
          {
            "group": "CLI 手册",
            "pages": ["cli/overview"]
          },
          {
            "group": "部署",
            "pages": ["deployment"]
          }
        ]
      },
      {
        "tab": "API 参考",
        "groups": [
          {
            "group": "核心框架",
            "pages": [
              "packages/core",
              "packages/loader",
              "packages/logger",
              "packages/schedule",
              "packages/model"
            ]
          },
          {
            "group": "HTTP 服务",
            "pages": [
              "packages/http",
              "packages/http-next"
            ]
          },
          {
            "group": "数据存储",
            "pages": [
              "packages/typeorm",
              "packages/ioredis",
              "packages/cache",
              "packages/redis-idempotency"
            ]
          },
          {
            "group": "消息通信",
            "pages": [
              "packages/message-modem",
              "packages/message-ipc",
              "packages/message-worker-thread",
              "packages/message-ws",
              "packages/message-loader"
            ]
          },
          {
            "group": "微服务",
            "pages": [
              "packages/micro",
              "packages/micro-dynamic-configs"
            ]
          },
          {
            "group": "开发工具",
            "pages": [
              "packages/cli",
              "packages/create-hile"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "NPM",
          "href": "https://www.npmjs.com/@hile/core",
          "icon": "npm"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/cevio/hile"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/cevio/hile"
    }
  }
}
