{
  "name": "@hile/logger",
  "version": "4.0.1",
  "description": "Structured logging based on pino",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && fix-esm-import-path --preserve-import-type ./dist",
    "dev": "tsc -b --watch",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "AI.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "fix-esm-import-path": "^1.10.3",
    "pino-pretty": "^13.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@hile/core": "workspace:^",
    "pino": "^10.0.0"
  },
  "peerDependencies": {
    "pino-pretty": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  }
}
