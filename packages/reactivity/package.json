{
  "name": "@hile/reactivity",
  "version": "3.0.0",
  "description": "Reactive state adapters for Hile topics, dynamic config, and runtime reloaders",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && fix-esm-import-path --preserve-import-type ./dist",
