{
  "name": "@hile/http-over-micro",
  "description": "Preserve HTTP semantics across Hile Micro calls with validated metadata and bidirectional streaming",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && fix-esm-import-path --preserve-import-type ./dist",
    "dev": "tsc -b --watch",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "AI.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hile/message-loader": "workspace:^",
    "@hile/message-modem": "workspace:^",
    "@hile/micro": "workspace:^",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hile/context": "workspace:^",
    "@types/node": "^26.2.0",
    "fix-esm-import-path": "^1.10.3",
    "vitest": "^4.0.18"
  }
}
