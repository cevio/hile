{
  "name": "@hile/rsc-discovery-hile",
  "description": "Hile Registry and message transport adapter for automatic RSC discovery",
  "version": "1.0.14",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && fix-esm-import-path --preserve-import-type ./dist",
    "dev": "tsc -b --watch",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hile/context": "workspace:^",
    "@hile/micro": "workspace:^",
    "@hile/rsc": "workspace:^",
    "@hile/rsc-discovery": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "fix-esm-import-path": "^1.10.3",
    "vitest": "^4.0.18"
  }
}
