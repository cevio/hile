    "fix-esm-import-path": "^1.10.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@hile/core": "workspace:^",
    "@hile/logger": "workspace:^",
    "async-exit-hook": "^2.0.1",
