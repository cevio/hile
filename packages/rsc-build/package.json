{
  "name": "@hile/rsc-build",
  "description": "Production compiler and artifact CLI for Hile RSC plugins",
  "version": "1.0.12",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hile-rsc": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli-index.d.ts",
      "import": "./dist/cli-index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -b --force && fix-esm-import-path --preserve-import-type ./dist",
    "dev": "tsc -b --watch",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hile/rsc": "workspace:^",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "fix-esm-import-path": "^1.10.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "^4.0.18"
  }
}
