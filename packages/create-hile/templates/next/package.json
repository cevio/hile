{
  "name": "@hile/http-next-example",
  "description": "Hile Http Next Example",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "build": "pnpm run build:base && pnpm run build:next",
    "build:base": "rm -rf dist && tsc -b && pnpm run build:fix",
    "build:next": "next build",
    "build:fix": "fix-esm-import-path --preserve-import-type ./dist ",
    "dev": "hile start --dev --env-file .env",
    "start": "hile start --env-file .env.prod"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "fix-esm-import-path": "^1.10.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@hile/cli": "^4.0.0",
    "@hile/core": "^4.0.0",
    "@hile/http": "^4.0.0",
    "@hile/http-next": "^4.0.0",
    "@hile/model": "^4.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
