{
  "name": "@hile/http-next-example",
  "description": "Hile Http Next Example",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:base && npm run build:next",
    "build:base": "rm -rf dist && tsc -b && npm run build:fix",
    "build:next": "next build",
    "build:fix": "fix-esm-import-path --preserve-import-type ./dist ",
    "dev": "hile start --dev --env-file .env",
    "start": "hile start --env-file .env.prod"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.1.0",
    "eslint-config-next": "16.3.0",
    "fix-esm-import-path": "^1.10.3"
  },
  "dependencies": {
    "@hile/cli": "^2.0.9",
    "@hile/core": "^2.0.1",
    "@hile/http": "^2.0.2",
    "@hile/http-next": "^2.0.4",
    "@hile/model": "^2.0.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
