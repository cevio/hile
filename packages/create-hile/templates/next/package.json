{
  "name": "@hile/http-next-example",
  "description": "Hile Http Next Example",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:base && npm run build:next",
    "build:base": "rm -rf dist && tsc -b && tsc -p tsconfig.controllers.json && npm run build:fix",
    "build:next": "next build",
    "build:fix": "fix-esm-import-path --preserve-import-type ./dist ",
    "dev": "npm run build:next && hile start --dev --env-file .env",
    "start": "hile start --env-file .env.prod"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "fix-esm-import-path": "^1.10.3"
  },
  "dependencies": {
    "@hile/cli": "^1.0.18",
    "@hile/core": "^1.0.20",
    "@hile/http": "^1.0.24",
    "@hile/http-next": "^1.0.1",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
