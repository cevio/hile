{
  "name": "rsc-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.12.0" },
  "scripts": {
    "build:runtime": "tsc -p tsconfig.runtime.json && fix-esm-import-path --preserve-import-type ./dist",
    "build:next": "next build",
    "build": "pnpm run build:runtime && pnpm run build:next",
    "dev": "hile start --dev --env-file .env",
    "start": "hile start --env-file .env.prod"
  },
  "dependencies": {
    "@hile/context": "^4.0.1",
    "@hile/cli": "^4.0.0",
    "@hile/core": "^4.0.0",
    "@hile/http-next": "^4.0.0",
    "@hile/micro": "^4.0.0",
    "@hile/rsc": "^1.0.0",
    "@hile/rsc-discovery-hile": "^1.0.0",
    "@hile/rsc-next": "^1.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@hile/rsc-development": "^1.0.0",
    "fix-esm-import-path": "^1.10.3",
    "typescript": "^7.0.2"
  }
}
