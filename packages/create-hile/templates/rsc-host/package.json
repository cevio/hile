{
  "name": "rsc-host",
  "private": true,
  "type": "module",
  "scripts": {
    "build:runtime": "tsc -p tsconfig.runtime.json && fix-esm-import-path --preserve-import-type ./dist",
    "build:next": "next build",
    "build": "npm run build:runtime && npm run build:next",
    "dev": "hile start --dev --env-file .env",
    "start": "hile start --env-file .env.prod"
  },
  "dependencies": {
    "@hile/cli": "^2.0.9",
    "@hile/core": "^2.0.1",
    "@hile/http-next": "^3.0.0",
    "@hile/micro": "^3.0.6",
    "@hile/rsc": "^0.1.0",
    "@hile/rsc-development": "^0.1.0",
    "@hile/rsc-next": "^0.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "fix-esm-import-path": "^1.10.3",
    "typescript": "^5.9.3"
  }
}
