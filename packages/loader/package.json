  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fix-esm-import-path": "^1.10.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "glob": "^13.0.6"
  }
}
