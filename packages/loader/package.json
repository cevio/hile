{
  "name": "@hile/loader",
  "version": "2.1.0",
  "description": "Shared file-scanning and route loader for @hile packages",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && fix-esm-import-path --preserve-import-type ./dist",
