{
  "name": "@hile/schedule",
  "version": "3.0.2",
  "description": "Declarative job scheduler based on node-schedule",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && fix-esm-import-path --preserve-import-type ./dist",
    "dev": "tsc -b --watch",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "AI.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node-schedule": "^2.1.7",
    "fix-esm-import-path": "^1.10.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@hile/loader": "workspace:^",
    "@hile/redis-lock": "workspace:^",
    "node-schedule": "^2.1.1"
  }
}
