{
  "name": "test-rsc-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:runtime": "tsc -p tsconfig.runtime.json && fix-esm-import-path --preserve-import-type ./dist",
    "build:next": "next build",
    "build": "pnpm build:runtime && pnpm build:next",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "dev": "hile start --dev --env-file .env",
    "start": "hile start --env-file .env.prod"
  },
  "dependencies": {
    "@hile/cli": "workspace:^",
    "@hile/core": "workspace:^",
    "@hile/http-next": "workspace:^",
    "@hile/micro": "workspace:^",
    "@hile/rsc": "workspace:^",
    "@hile/rsc-development": "workspace:^",
    "@hile/rsc-next": "workspace:^",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "fix-esm-import-path": "^1.10.3",
    "typescript": "^5.9.3"
  }
}
