{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/services/**/*", "src/models/**/*", "src/mcps/**/*", "src/mcps-labs/**/*"],
  "exclude": ["node_modules", "dist", ".hile-rsc"]
}
